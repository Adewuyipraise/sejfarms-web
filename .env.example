# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Verified sender, e.g. "Sejfarms Website <no-reply@sejfarmsgroup.com>".
# Falls back to Resend's onboarding sender when unset.
RESEND_FROM=
# Inbox that receives contact / application / resource notifications.
# Falls back to the address hardcoded in src/lib/mail.ts when unset.
CONTACT_INBOX=

# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-12
# Read token: only needed to preview draft content.
SANITY_API_READ_TOKEN=
# Write token: only needed by the `scripts/migrate-*.ts` utilities.
SANITY_API_WRITE_TOKEN=
# Shared secret expected by POST /api/revalidate (Sanity webhook).
SANITY_REVALIDATE_SECRET=

# --- Public ---
# Reserved for an env-driven WhatsApp number (currently hardcoded in src/lib/whatsapp.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=
